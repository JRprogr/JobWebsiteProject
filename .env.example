# Copy to .env.local for local work. Never commit real values.

# Neon Postgres connection string. Use the "dev" branch locally, the production branch only in Vercel and GitHub secrets.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The person responsible for the site, shown on the Impressum and named on the Privacy page. Address lines are separated by "|".
# Required in production (the build refuses to deploy without them); locally the pages show a placeholder if unset.
OPERATOR_NAME=Jane Doe
OPERATOR_ADDRESS=Example Street 1 | 12345 Example Town | Germany

# Optional: a second connection string that may change the schema (owner role). If set, a Vercel production build runs the
# migrations and the company sync with it, so DATABASE_URL itself can be a read-only role.
# DATABASE_ADMIN_URL=postgresql://owner:password@host/dbname?sslmode=require

# Public URL of the site (sitemap, canonical and share links, and the address the scraper's user agent points to).
# A Vercel deploy falls back to its own production URL (VERCEL_PROJECT_PRODUCTION_URL), local dev to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com
