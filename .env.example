# Copy to .env.local for local work. Never commit real values.

# Neon Postgres connection string. Use the pooled "dev" branch locally, the production branch only in Vercel and GitHub secrets.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public URL of the site (sitemap, canonical and share links). Optional until the site has its own domain:
# a Vercel deploy falls back to its own production URL, local dev to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Shared secret for the /api/cron/scrape endpoint (removed once scraping moves to GitHub Actions).
CRON_SECRET=
